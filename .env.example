# Anthropic Claude API
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Clever API (optional — app runs on mock data without this)
VITE_CLEVER_CLIENT_ID=your_clever_client_id_here
VITE_CLEVER_CLIENT_SECRET=your_clever_client_secret_here
VITE_CLEVER_DISTRICT_ID=your_clever_district_id_here

# Set to "clever" to use Clever API, "mock" to use built-in mock data
VITE_DATA_SOURCE=mock
